{
  "name": "pi-notify-telegram",
  "version": "0.2.2",
  "description": "Threaded Telegram remote interface for Pi sessions with native streaming and notification replies",
  "type": "module",
  "files": [
    "index.ts",
    "src",
    "setup.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "devDependencies": {
