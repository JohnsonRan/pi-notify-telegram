    "@types/node": "^26.0.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "telegram",
    "notifications",
    "streaming",
    "threads"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnsonRan/pi-notify-telegram.git"
  },
  "bugs": {
